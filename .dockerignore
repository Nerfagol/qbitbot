# Deny all, reopen required parents, then deny their children before exact allow rules.
# A parent exception alone would also admit private descendants.
**
!deploy/
deploy/**
!deploy/docker/
deploy/docker/**
!deploy/docker/*.Dockerfile
!deploy/docker/flaresolverr/
deploy/docker/flaresolverr/**
!deploy/docker/flaresolverr/*.py
!deploy/docker/flaresolverr/LICENSE
!requirements/
requirements/**
!requirements/runtime.lock
!qbitbot/
qbitbot/**
!qbitbot/*.py
!qbitbot/cli/
qbitbot/cli/**
!qbitbot/cli/*.py
!qbitbot/locales/
qbitbot/locales/**
!qbitbot/locales/*.json
!LICENSE
!docs/
docs/**
!docs/licenses/
docs/licenses/**
!docs/licenses/THIRD_PARTY_NOTICES.md
